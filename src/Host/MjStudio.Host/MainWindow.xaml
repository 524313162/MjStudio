<Window x:Class="MjStudio.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:views="clr-namespace:MjStudio.Host.Views"
        xmlns:conv="clr-namespace:MjStudio.Host.Converters"
        Title="MjStudio · AI漫剧制作"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <conv:NavHighlightConverter x:Key="NavFg"/>
        <conv:NavBgConverter x:Key="NavBg"/>

        <!-- 窗口控制按钮（最小化/最大化） -->
        <Style x:Key="CaptionButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="40"/>
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#E8ECF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮（hover 变红） -->
        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 窗口主体：外层阴影（不裁剪，阴影可见）+ 内层圆角内容（裁剪到圆角） -->
    <Border x:Name="ShadowBorder"
            Margin="20"
            CornerRadius="14"
            Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36"
                              ShadowDepth="6"
                              Direction="270"
                              Opacity="0.45"
                              Color="#000000"/>
        </Border.Effect>
        <Border x:Name="RootBorder"
                CornerRadius="14"
                Background="{StaticResource PageBgBrush}"
                BorderBrush="#B8C2D4"
                BorderThickness="1.5"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ 左侧导航 ============ -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBgBrush}">
                    <DockPanel>
                        <!-- Logo（可拖动窗口）+ 收起按钮 -->
                        <Border DockPanel.Dock="Top"
                                Height="64"
                                Padding="20,0"
                                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                            <DockPanel>
                                <!-- 收起/展开按钮 -->
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource NavButton}"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleSidebarCommand}"
                                        ToolTip="收起/展开侧边栏">
                                    <TextBlock Text="◀"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SidebarCollapsed}"
                                                                 Value="True">
                                                        <Setter Property="Text"
                                                                Value="▶"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="10"
                                            Background="{StaticResource PrimaryBrush}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="M"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MjStudio"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="AI 漫剧制作"
                                                   Foreground="#6B7280"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 底部：设置 -->
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource NavButton}"
                                Margin="8,8,8,16"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="settings">
                            <Button.Background>
                                <Binding Path="CurrentPage"
                                         Converter="{StaticResource NavBg}"
                                         ConverterParameter="settings"/>
                            </Button.Background>
                            <Button.Foreground>
                                <Binding Path="CurrentPage"
                                         Converter="{StaticResource NavFg}"
                                         ConverterParameter="settings"/>
                            </Button.Foreground>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="设置"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 导航项 -->
                        <StackPanel Margin="0,8">
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="projects">
                                <Button.Background>
                                    <Binding Path="CurrentPage"
                                             Converter="{StaticResource NavBg}"
                                             ConverterParameter="projects"/>
                                </Button.Background>
                                <Button.Foreground>
                                    <Binding Path="CurrentPage"
                                             Converter="{StaticResource NavFg}"
                                             ConverterParameter="projects"/>
                                </Button.Foreground>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="项目"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="assets">
                                <Button.Background>
                                    <Binding Path="CurrentPage"
                                             Converter="{StaticResource NavBg}"
                                             ConverterParameter="assets"/>
                                </Button.Background>
                                <Button.Foreground>
                                    <Binding Path="CurrentPage"
                                             Converter="{StaticResource NavFg}"
                                             ConverterParameter="assets"/>
                                </Button.Foreground>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎭"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="资产"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="workflow">
                                <Button.Background>
                                    <Binding Path="CurrentPage"
                                             Converter="{StaticResource NavBg}"
                                             ConverterParameter="workflow"/>
                                </Button.Background>
                                <Button.Foreground>
                                    <Binding Path="CurrentPage"
                                             Converter="{StaticResource NavFg}"
                                             ConverterParameter="workflow"/>
                                </Button.Foreground>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="工作流"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============ 主区域 ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶栏：页面标题 + 当前项目 + API 状态 + 窗口按钮（可拖动） -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                        <DockPanel Margin="24,0">
                            <!-- 窗口控制按钮（最右） -->
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                <Button x:Name="MinimizeButton"
                                        Style="{StaticResource CaptionButton}"
                                        Content="─"
                                        Click="OnMinimizeClick"/>
                                <Button x:Name="MaximizeButton"
                                        Style="{StaticResource CaptionButton}"
                                        Content="▢"
                                        Click="OnMaximizeClick"/>
                                <Button x:Name="CloseButton"
                                        Style="{StaticResource CloseButton}"
                                        Content="✕"
                                        Click="OnCloseClick"/>
                            </StackPanel>
                            <!-- API 状态（右） -->
                            <Border DockPanel.Dock="Right"
                                    Background="#F0FFF4"
                                    CornerRadius="12"
                                    Padding="12,5"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApiRunning}"
                                                                 Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="API 未启动"/>
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApiRunning}"
                                                                 Value="True">
                                                        <Setter Property="Text"
                                                                Value="API 已启动"/>
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ComfyUI 状态（右） -->
                            <Border DockPanel.Dock="Right"
                                    Background="#FFF5F5"
                                    CornerRadius="12"
                                    Padding="12,5"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ComfyHealthy}"
                                                                 Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ComfyUiBaseUrl}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ComfyStatusText}"
                                               FontSize="12"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ComfyHealthy}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 页面标题（左） -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <!-- 当前项目（只读展示，切换在项目页进行） -->
                                <Border Background="{StaticResource PrimaryLightBrush}"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsProjectLoaded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CurrentProjectName}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 内容区 -->
                    <Grid Grid.Row="1"
                          Margin="20">
                        <ContentControl Content="{Binding ProjectsPage}"
                                        Visibility="{Binding ShowProjects, Converter={StaticResource BoolToVis}}"/>
                        <ContentControl Content="{Binding AssetsPage}"
                                        Visibility="{Binding ShowAssets, Converter={StaticResource BoolToVis}}"/>
                        <ContentControl Content="{Binding ShotsPage}"
                                        Visibility="{Binding ShowShots, Converter={StaticResource BoolToVis}}"/>
                        <ContentControl Content="{Binding StoryPage}"
                                        Visibility="{Binding ShowStory, Converter={StaticResource BoolToVis}}"/>
                        <ContentControl Content="{Binding WorkflowPage}"
                                        Visibility="{Binding ShowWorkflow, Converter={StaticResource BoolToVis}}"/>
                        <ContentControl Content="{Binding SettingsPage}"
                                        Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
