<Window x:Class="MjStudio.Host.Views.BindAssetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="绑定资产"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部提示 -->
        <TextBlock Grid.Row="0"
                   Text="勾选要绑定的资产（角色/场景/BGM/音效），可多选"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,10"/>

        <!-- 搜索框 -->
        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <hc:TextBox x:Name="SearchBox"
                        Grid.Column="0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="12"
                        Padding="8,6"
                        hc:InfoElement.Placeholder="输入资产名称搜索"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding FilteredCount, StringFormat='{}{0} 个'}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Grid>

        <!-- 资产列表 -->
        <Border Grid.Row="2"
                Background="{StaticResource PageBgBrush}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AssetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,8"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnItemClicked">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 勾选框 -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsChecked}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>

                                        <!-- 头像 -->
                                        <Border Grid.Column="1"
                                                Width="44"
                                                Height="44"
                                                CornerRadius="6"
                                                Background="{StaticResource PageBgBrush}"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding ImagePath, Converter={StaticResource ImagePath}}"
                                                       Stretch="UniformToFill"
                                                       Width="44"
                                                       Height="44"/>
                                                <TextBlock Text="�"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasImage, Converter={StaticResource InverseBool}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- 类型 + 名称 + 描述 -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <Border Background="{StaticResource PrimaryLightBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,4">
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="未找到匹配的角色"
                           Style="{StaticResource EmptyHint}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding FilteredCount, Converter={StaticResource CountToVis}}"/>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick"
                        MinWidth="80"
                        FontSize="13"/>
                <Button Content="确定绑定"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnConfirmClick"
                        MinWidth="100"
                        Margin="10,0,0,0"
                        FontSize="13"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
