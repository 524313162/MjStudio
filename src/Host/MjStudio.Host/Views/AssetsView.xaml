<UserControl x:Class="MjStudio.Host.Views.AssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <!-- ===== 主内容区：卡片网格 ===== -->
        <DockPanel>
            <!-- 顶部：搜索 + 类型过滤 + 新建资产 -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="🔍"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <hc:TextBox Grid.Column="1"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                hc:InfoElement.Placeholder="搜索资产（名称 / 描述）"
                                FontSize="13"/>
                    <TextBlock Grid.Column="2"
                               Text="类型"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding TypeFilterOptions}"
                              SelectedItem="{Binding FilterType}"
                              Width="110"
                              VerticalAlignment="Center"
                              FontSize="13">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource NullableEnumDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="5"
                            Content="＋ 新建资产"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateCommand}"
                            FontSize="13"
                            Padding="16,7"/>
                </Grid>
            </Border>

            <!-- 资产表格 -->
            <Grid>
                <!-- 空状态 -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding FilteredCards.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock Text="🎭"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="暂无资产，点击右上角「新建资产」创建"
                               Style="{StaticResource EmptyHint}"/>
                </StackPanel>

                <!-- 表格 -->
                <DataGrid ItemsSource="{Binding FilteredCards}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BorderBrush}"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          RowHeight="52"
                          FontSize="13"
                          MouseDoubleClick="OnRowDoubleClick">
                    <DataGrid.Columns>
                        <!-- 类型 -->
                        <DataGridTemplateColumn Header="类型"
                                                Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PrimaryLightBrush}"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TypeDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 名称（悬停预览图片/音频） -->
                        <DataGridTemplateColumn Header="名称"
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                MouseEnter="OnNameMouseEnter"
                                                MouseLeave="OnNameMouseLeave">
                                        <!-- 图片资产：缩略图 -->
                                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePath}}"
                                               Width="36"
                                               Height="36"
                                               Stretch="UniformToFill"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="OnImageClick"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"
                                               Margin="0,0,10,0"/>
                                        <!-- 音频资产：播放图标 -->
                                        <Button Content="🎵"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="18"
                                                Cursor="Hand"
                                                Click="OnPlayAudioClick"
                                                Tag="{Binding AudioPath}"
                                                ToolTip="点击播放"
                                                Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 描述（点击查看完整） -->
                        <DataGridTemplateColumn Header="描述"
                                                Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center"
                                               Cursor="Hand"
                                               ToolTip="点击查看完整描述与提示词"
                                               MouseLeftButtonDown="OnDescriptionClick"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 引用项目 -->
                        <DataGridTemplateColumn Header="引用项目"
                                                Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="🔗"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding RefProjects}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 子资产 -->
                        <DataGridTemplateColumn Header="子资产"
                                                Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Children}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PageBgBrush}"
                                                        CornerRadius="6"
                                                        Padding="8,4"
                                                        Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                   Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="120"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>

        <!-- ===== 右侧抽屉 ===== -->
        <Grid x:Name="DrawerRoot"
              Visibility="Collapsed">
            <!-- 遮罩层（点击关闭） -->
            <Border x:Name="DrawerMask"
                    Background="#66000000"
                    MouseLeftButtonDown="OnDrawerMaskClick"/>

            <!-- 抽屉面板 -->
            <Border x:Name="DrawerPanel"
                    HorizontalAlignment="Right"
                    Width="600"
                    Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="0"
                                      Opacity="0.22"
                                      Color="#1A202C"/>
                </Border.Effect>
                <DockPanel>
                    <!-- 抽屉头部 -->
                    <Border DockPanel.Dock="Top"
                            Padding="24,16"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <!-- 新建子资产（仅编辑已有资产时可用） -->
                                <Button Content="＋ 子资产"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CreateChildCommand}"
                                        FontSize="13"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="✕"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CloseDrawerCommand}"
                                        Padding="8,4"
                                        FontSize="14"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding DrawerTitle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding DrawerSubtitle}"
                                           FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 底部操作栏 -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="24,14"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="🗑 删除"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}"
                                    FontSize="13"
                                    Margin="0,0,12,0"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="💾 保存"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}"
                                    FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- 表单内容 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <!-- 基本信息 -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <Border Width="3"
                                            Height="14"
                                            CornerRadius="2"
                                            Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="基本信息"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="资产名称"
                                           Style="{StaticResource FieldLabel}"/>
                                <hc:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                            hc:InfoElement.Placeholder="资产名称"/>
                                <TextBlock Text="资产类型"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,4"/>
                                <ComboBox ItemsSource="{Binding Types}"
                                          SelectedItem="{Binding FormAssetType}"
                                          IsEnabled="{Binding CanEditType}"
                                          FontSize="13">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="子资产可自由选择类型（角色的声音=音频、变装=角色、场景子面=场景）"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding IsCreatingChild, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="描述（用途 / 环境氛围 / 身份 / 外貌 / 场景面 / 区域 / 音频风格等全部事实信息）"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,4"/>
                                <hc:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True"
                                            Height="72"
                                            VerticalScrollBarVisibility="Auto"
                                            VerticalContentAlignment="Top"
                                            hc:InfoElement.Placeholder="描述"/>
                            </StackPanel>
                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,20"/>

                            <!-- 引用项目 -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <Border Width="3"
                                            Height="14"
                                            CornerRadius="2"
                                            Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="引用项目"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="勾选使用本资产的项目（不勾选即为通用资产）"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ProjectRefItems}"
                                              MaxHeight="160">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <Border Background="{StaticResource PageBgBrush}"
                                                    CornerRadius="8"
                                                    Padding="12">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              MaxHeight="160">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Margin="0,4"
                                                      FontSize="13"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,20"/>

                            <!-- 子资产（角色声音/变装、场景子面） -->
                            <StackPanel Margin="0,0,0,20"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <Border Width="3"
                                            Height="14"
                                            CornerRadius="2"
                                            Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="子资产"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="角色的声音/变装、场景的子面等细分形态，作为本资产的子资产"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Selected.Children}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PageBgBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AssetType, Converter={StaticResource EnumDisplay}}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,20"/>

                            <!-- 全部描述（提示词预览） -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <Border Width="3"
                                            Height="14"
                                            CornerRadius="2"
                                            Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="资产全部描述（提示词，实时预览）"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Border Background="#F5F8FC"
                                        CornerRadius="8"
                                        Padding="12"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding PreviewDescription}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="200"/>
                                </Border>
                            </StackPanel>
                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,20"/>

                            <!-- 提示词（单个正向 + 单个反向，中英文均可） -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <Border Width="3"
                                            Height="14"
                                            CornerRadius="2"
                                            Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="提示词"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="正向提示词（中英文均可）"
                                           Style="{StaticResource FieldLabel}"/>
                                <hc:TextBox Text="{Binding FormPrompt, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True"
                                            Height="72"
                                            VerticalScrollBarVisibility="Auto"
                                            VerticalContentAlignment="Top"
                                            hc:InfoElement.Placeholder="描述画面/音频内容，可写中文或英文"/>
                                <TextBlock Text="反向提示词（中英文均可）"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,4"/>
                                <hc:TextBox Text="{Binding FormNegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True"
                                            Height="56"
                                            VerticalScrollBarVisibility="Auto"
                                            VerticalContentAlignment="Top"
                                            hc:InfoElement.Placeholder="不希望出现的内容，可写中文或英文"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 只读详情抽屉（描述列点击） ===== -->
        <Grid x:Name="DetailDrawerRoot"
              Visibility="Collapsed">
            <Border x:Name="DetailDrawerMask"
                    Background="#66000000"
                    MouseLeftButtonDown="OnDetailDrawerMaskClick"/>
            <Border x:Name="DetailDrawerPanel"
                    HorizontalAlignment="Right"
                    Width="520"
                    Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="0"
                                      Opacity="0.22"
                                      Color="#1A202C"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="24,16"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OnDetailDrawerClose"
                                    Padding="8,4"
                                    FontSize="14"/>
                            <StackPanel>
                                <TextBlock x:Name="DetailTitle"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="DetailSubtitle"
                                           FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailContent"
                                    Margin="24"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 悬停预览（名称列） ===== -->
        <Popup x:Name="HoverPopup"
               Placement="Mouse"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Width="260">
                <StackPanel>
                    <Image x:Name="HoverImage"
                           MaxHeight="180"
                           Stretch="Uniform"
                           Visibility="Collapsed"/>
                    <StackPanel x:Name="HoverAudioPanel"
                                Visibility="Collapsed">
                        <TextBlock x:Name="HoverAudioName"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8"/>
                        <Button x:Name="HoverPlayButton"
                                Content="▶"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnHoverPlayClick"
                                FontSize="13"
                                Padding="12,4"/>
                    </StackPanel>
                    <TextBlock x:Name="HoverNoMedia"
                               Text="暂无媒体"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
