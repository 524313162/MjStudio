<UserControl x:Class="MjStudio.Host.Views.StoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 工具栏：搜索 + 刷新 ===== -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="搜索"
                           Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <hc:TextBox Grid.Column="1"
                            x:Name="SearchBox"
                            Text="{Binding SearchTitle, UpdateSourceTrigger=PropertyChanged}"
                            Width="220"
                            FontSize="12"
                            Padding="8,6"
                            KeyDown="OnSearchKeyDown"
                            hc:InfoElement.Placeholder="输入标题关键字，回车搜索"/>
                <Button Grid.Column="2"
                        Content="🔍 搜索"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SearchCommand}"
                        Margin="8,0,0,0"
                        FontSize="13"/>
                <Button Grid.Column="3"
                        Content="刷新"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right"
                        FontSize="13"/>
                <TextBlock Grid.Column="4"
                           Text="{Binding Stories.Count, StringFormat='共 {0} 集'}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：剧本列表 ===== -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="10"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部：剧本列表标题 + 新建（加号）融合 -->
                    <Border Grid.Row="0"
                            Background="{StaticResource PageBgBrush}"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="📝"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="剧本列表"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{StaticResource PrimaryLightBrush}"
                                        CornerRadius="8"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stories.Count, StringFormat='{}{0}'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CreateCommand}"
                                    ToolTip="新建剧本"
                                    Width="30"
                                    Height="30"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="15">
                                            <TextBlock Text="＋"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Opacity"
                                                        Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 列表 -->
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Stories}"
                                 SelectedItem="{Binding Selected}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Margin"
                                            Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="12,10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{StaticResource PageBgBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected"
                                                             Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{StaticResource PrimaryLightBrush}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter TargetName="Bd"
                                                                Property="BorderThickness"
                                                                Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 集数徽章 -->
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding EpisodeNo, StringFormat='{}{0}'}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- 标题 + 时长 -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,3,0,0">
                                                <TextBlock Text="第"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding EpisodeNo, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="集"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text=" · "
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Duration, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="s"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="暂无剧本，点击上方「＋ 新建剧本」添加"
                                   Style="{StaticResource EmptyHint}"
                                   Visibility="{Binding Stories.Count, Converter={StaticResource CountToVis}}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 右侧：剧本编辑区 ===== -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="20">
                <Grid>
                    <!-- 空状态 -->
                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="📝"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="选择左侧剧本进行编辑"
                                   Style="{StaticResource EmptyHint}"/>
                    </StackPanel>

                    <!-- 编辑内容 -->
                    <Grid Visibility="{Binding Selected, Converter={StaticResource NullToVisInverse}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 标题栏 -->
                        <Border Grid.Row="0"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.EpisodeNo, StringFormat='第{0}集'}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Selected.Title}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2"
                                        Content="💾 保存"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCommand}"
                                        Margin="12,0,0,0"
                                        FontSize="13"/>
                                <Button Grid.Column="3"
                                        Content="🗑 删除"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteCommand}"
                                        Margin="8,0,0,0"
                                        FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- 正文 -->
                        <Border Grid.Row="1"
                                Background="#FAFBFC"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="16,12">
                            <hc:TextBox Text="{Binding Selected.Content, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        FontSize="13"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="0"/>
                        </Border>

                        <!-- 底部提示 -->
                        <Grid Grid.Row="2"
                              Margin="0,8,0,0">
                            <TextBlock Text="支持 Markdown 格式 · 角色/场景/BGM/音效等资产在「分镜」环节按镜头绑定"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding Selected.Content, Converter={StaticResource CharCount}}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

