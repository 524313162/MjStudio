<UserControl x:Class="MjStudio.Host.Views.ShotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
        <Grid>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左侧：集列表 ===== -->
                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        Padding="10"
                        Margin="0,0,16,0">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 顶部：分集标题 + 集数 -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource PageBgBrush}"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,10">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="🎬"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"/>
                                                        <TextBlock Text="分集"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                                CornerRadius="8"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Episodes.Count, StringFormat='{}{0}'}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                        </Border>
                                                </StackPanel>
                                        </Grid>
                                </Border>

                                <!-- 集列表 -->
                                <Grid Grid.Row="1">
                                        <ListBox ItemsSource="{Binding Episodes}"
                                                 SelectedItem="{Binding SelectedEpisode}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding"
                                                                        Value="0"/>
                                                                <Setter Property="Margin"
                                                                        Value="0,0,0,8"/>
                                                                <Setter Property="HorizontalContentAlignment"
                                                                        Value="Stretch"/>
                                                                <Setter Property="Background"
                                                                        Value="Transparent"/>
                                                                <Setter Property="BorderThickness"
                                                                        Value="0"/>
                                                                <Setter Property="Template">
                                                                        <Setter.Value>
                                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                                        <Border x:Name="Bd"
                                                                                                Background="{TemplateBinding Background}"
                                                                                                CornerRadius="8"
                                                                                                Padding="12,10">
                                                                                                <ContentPresenter/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsMouseOver"
                                                                                                         Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="Background"
                                                                                                                Value="{StaticResource PageBgBrush}"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsSelected"
                                                                                                         Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="Background"
                                                                                                                Value="{StaticResource PrimaryLightBrush}"/>
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="BorderBrush"
                                                                                                                Value="{StaticResource PrimaryBrush}"/>
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="BorderThickness"
                                                                                                                Value="1"/>
                                                                                                </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- 集数徽章 -->
                                                                        <Border Grid.Column="0"
                                                                                Width="40"
                                                                                Height="40"
                                                                                CornerRadius="20"
                                                                                Background="{StaticResource PrimaryLightBrush}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,12,0">
                                                                                <TextBlock Text="{Binding EpisodeNo, StringFormat='{}{0}'}"
                                                                                           FontSize="15"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"/>
                                                                        </Border>

                                                                        <!-- 名称 + 镜头数 -->
                                                                        <StackPanel Grid.Column="1"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="SemiBold"
                                                                                           FontSize="13"
                                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding Shots.Count, StringFormat='{}{0} 个镜头'}"
                                                                                           FontSize="11"
                                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                                           Margin="0,3,0,0"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="暂无分集"
                                                   Style="{StaticResource EmptyHint}"
                                                   FontSize="12"
                                                   Visibility="{Binding Episodes.Count, Converter={StaticResource CountToVis}}"/>
                                </Grid>
                        </Grid>
                </Border>

                <!-- ===== 右侧：镜头列表 + 编辑表单 ===== -->
                <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 镜头列表 -->
                        <Border Grid.Column="0"
                                Style="{StaticResource Card}"
                                Padding="10"
                                Margin="0,0,16,0">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- 顶部：镜头标题 + 新建 -->
                                        <Border Grid.Row="0"
                                                Background="{StaticResource PageBgBrush}"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,10">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="🎞️"
                                                                           FontSize="14"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <TextBlock Text="镜头"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Background="{StaticResource PrimaryLightBrush}"
                                                                        CornerRadius="8"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Shots.Count, StringFormat='{}{0}'}"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                                </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding CreateShotCommand}"
                                                                ToolTip="新建镜头"
                                                                Width="30"
                                                                Height="30"
                                                                Cursor="Hand">
                                                                <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="Bd"
                                                                                        Background="{StaticResource PrimaryBrush}"
                                                                                        CornerRadius="15">
                                                                                        <TextBlock Text="＋"
                                                                                                   FontSize="16"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="White"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver"
                                                                                                 Value="True">
                                                                                                <Setter TargetName="Bd"
                                                                                                        Property="Opacity"
                                                                                                        Value="0.85"/>
                                                                                        </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                </Button.Template>
                                                        </Button>
                                                </Grid>
                                        </Border>

                                        <!-- 镜头列表 -->
                                        <Grid Grid.Row="1">
                                                <ListBox ItemsSource="{Binding Shots}"
                                                         SelectedItem="{Binding SelectedShot}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                        <Setter Property="Padding"
                                                                                Value="0"/>
                                                                        <Setter Property="Margin"
                                                                                Value="0,0,0,8"/>
                                                                        <Setter Property="HorizontalContentAlignment"
                                                                                Value="Stretch"/>
                                                                        <Setter Property="Background"
                                                                                Value="Transparent"/>
                                                                        <Setter Property="BorderThickness"
                                                                                Value="0"/>
                                                                        <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                                                <Border x:Name="Bd"
                                                                                                        Background="{TemplateBinding Background}"
                                                                                                        CornerRadius="8"
                                                                                                        Padding="12,10">
                                                                                                        <ContentPresenter/>
                                                                                                </Border>
                                                                                                <ControlTemplate.Triggers>
                                                                                                        <Trigger Property="IsMouseOver"
                                                                                                                 Value="True">
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="{StaticResource PageBgBrush}"/>
                                                                                                        </Trigger>
                                                                                                        <Trigger Property="IsSelected"
                                                                                                                 Value="True">
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="{StaticResource PrimaryLightBrush}"/>
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="BorderBrush"
                                                                                                                        Value="{StaticResource PrimaryBrush}"/>
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="BorderThickness"
                                                                                                                        Value="1"/>
                                                                                                        </Trigger>
                                                                                                </ControlTemplate.Triggers>
                                                                                        </ControlTemplate>
                                                                                </Setter.Value>
                                                                        </Setter>
                                                                </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- 镜头号徽章 -->
                                                                                <Border Grid.Column="0"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        CornerRadius="18"
                                                                                        Background="{StaticResource PrimaryLightBrush}"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="0,0,10,0">
                                                                                        <TextBlock Text="{Binding ShotNo, StringFormat='{}{0}'}"
                                                                                                   FontSize="13"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </Border>

                                                                                <!-- 标题 + 摘要 -->
                                                                                <StackPanel Grid.Column="1"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Title}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   FontSize="13"
                                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Text="{Binding VideoContent}"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   MaxHeight="32"
                                                                                                   Margin="0,3,0,0"/>
                                                                                </StackPanel>
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="暂无镜头，点击上方「＋」新建"
                                                           Style="{StaticResource EmptyHint}"
                                                           FontSize="12"
                                                           Visibility="{Binding Shots.Count, Converter={StaticResource CountToVis}}"/>
                                        </Grid>
                                </Grid>
                        </Border>

                        <!-- 编辑表单 -->
                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Padding="20">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- 导出工具栏 -->
                                        <Border Grid.Row="0"
                                                Background="{StaticResource PageBgBrush}"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,16">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0"
                                                                Content="📦 批量生成"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding OpenBatchGenCommand}"
                                                                FontSize="13"
                                                                ToolTip="一键生成所有图片/声音/视频资源"/>
                                                        <Button Grid.Column="1"
                                                                Content="🎬 原声导出"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding ExportOriginalCommand}"
                                                                FontSize="13"
                                                                Margin="8,0,0,0"/>
                                                        <Button Grid.Column="2"
                                                                Content="🎤 换声导出"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding ExportVoiceSwapCommand}"
                                                                FontSize="13"
                                                                Margin="8,0,0,0"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding ExportStatusText}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                        </Border>

                                        <!-- 空状态（覆盖标题行+表单） -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.RowSpan="2"
                                                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <TextBlock Text="🎬"
                                                           FontSize="48"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="选择左侧镜头查看详情，或点击「＋」新建"
                                                           Style="{StaticResource EmptyHint}"/>
                                        </StackPanel>

                                        <!-- 标题行（固定顶部，不随内容滚动） -->
                                        <Border Grid.Row="1"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                CornerRadius="8"
                                                Padding="16,12"
                                                Margin="0,0,0,16"
                                                Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Background="{StaticResource PrimaryBrush}"
                                                                CornerRadius="6"
                                                                Padding="10,4"
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedShot.ShotNo, StringFormat='镜头#{0}'}"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"/>
                                                        </Border>
                                                        <hc:TextBox Grid.Column="1"
                                                                    Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Padding="8,6"
                                                                    hc:InfoElement.Placeholder="镜头标题"
                                                                    VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2"
                                                                Content="💾 保存"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding SaveCommand}"
                                                                Margin="12,0,0,0"
                                                                FontSize="13"/>
                                                        <Button Grid.Column="3"
                                                                Content="取消"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding CancelEditCommand}"
                                                                Margin="8,0,0,0"
                                                                FontSize="13"/>
                                                        <Button Grid.Column="4"
                                                                Content="🗑 删除"
                                                                Style="{StaticResource DangerButton}"
                                                                Command="{Binding DeleteCommand}"
                                                                Margin="8,0,0,0"
                                                                FontSize="13"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                        </Border>

                                        <!-- 编辑表单（滚动区） -->
                                        <ScrollViewer Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                                                <StackPanel MaxWidth="1000"
                                                            HorizontalAlignment="Stretch">
                                                        <!-- 运镜/景别/转场 + 视频（两列） -->
                                                        <Grid Margin="0,0,0,16">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- 左列：运镜/景别/转场（3行，无大标题） -->
                                                                <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="运镜"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:TextBox Text="{Binding FormCamera, UpdateSourceTrigger=PropertyChanged}"
                                                                                    hc:InfoElement.Placeholder="如：全景+固定机位+缓慢推近"
                                                                                    Margin="0,0,0,8"/>
                                                                        <TextBlock Text="景别"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding ShotSizeOptions}"
                                                                                     SelectedItem="{Binding FormShotSize, UpdateSourceTrigger=PropertyChanged}"
                                                                                     hc:InfoElement.Placeholder="选择景别"
                                                                                     Margin="0,0,0,8"/>
                                                                        <TextBlock Text="转场"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding TransitionOptions}"
                                                                                     SelectedItem="{Binding FormTransition, UpdateSourceTrigger=PropertyChanged}"
                                                                                     hc:InfoElement.Placeholder="选择转场方式"/>
                                                                </StackPanel>

                                                                <!-- 右列：视频 -->
                                                                <StackPanel Grid.Column="2">
                                                                        <Border Background="#1a1a2e"
                                                                                CornerRadius="8"
                                                                                Height="200">
                                                                                <Grid>
                                                                                        <!-- 无视频占位 -->
                                                                                        <StackPanel VerticalAlignment="Center"
                                                                                                    HorizontalAlignment="Center"
                                                                                                    Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                                                                <TextBlock Text="🎬"
                                                                                                           FontSize="36"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           Margin="0,0,0,8"/>
                                                                                                <TextBlock Text="暂无视频"
                                                                                                           FontSize="13"
                                                                                                           Foreground="#888"
                                                                                                           HorizontalAlignment="Center"/>
                                                                                        </StackPanel>

                                                                                        <!-- 有视频：播放器 -->
                                                                                        <MediaElement Source="{Binding VideoUri}"
                                                                                                      LoadedBehavior="Play"
                                                                                                      UnloadedBehavior="Stop"
                                                                                                      Stretch="Uniform"
                                                                                                      ScrubbingEnabled="True"
                                                                                                      Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}"/>

                                                                                        <!-- 生成中遮罩 -->
                                                                                        <Border Background="#80000000"
                                                                                                CornerRadius="8"
                                                                                                Visibility="{Binding IsGeneratingVideo, Converter={StaticResource BoolToVis}}">
                                                                                                <StackPanel VerticalAlignment="Center"
                                                                                                            HorizontalAlignment="Center">
                                                                                                        <TextBlock Text="⏳"
                                                                                                                   FontSize="32"
                                                                                                                   HorizontalAlignment="Center"
                                                                                                                   Margin="0,0,0,8"/>
                                                                                                        <TextBlock Text="正在生成视频…"
                                                                                                                   FontSize="13"
                                                                                                                   Foreground="White"
                                                                                                                   HorizontalAlignment="Center"/>
                                                                                                </StackPanel>
                                                                                        </Border>

                                                                                        <!-- 右上角小按钮：生成/重新生成 -->
                                                                                        <Button HorizontalAlignment="Right"
                                                                                                VerticalAlignment="Top"
                                                                                                Margin="0,6,6,0"
                                                                                                Width="28"
                                                                                                Height="28"
                                                                                                Cursor="Hand"
                                                                                                ToolTip="生成/重新生成视频"
                                                                                                Command="{Binding GenerateVideoCommand}">
                                                                                                <Button.Template>
                                                                                                        <ControlTemplate TargetType="Button">
                                                                                                                <Border x:Name="Bd"
                                                                                                                        Background="#80000000"
                                                                                                                        CornerRadius="14"
                                                                                                                        BorderBrush="#60FFFFFF"
                                                                                                                        BorderThickness="1">
                                                                                                                        <TextBlock Text="⚡"
                                                                                                                                   FontSize="14"
                                                                                                                                   Foreground="White"
                                                                                                                                   HorizontalAlignment="Center"
                                                                                                                                   VerticalAlignment="Center"/>
                                                                                                                </Border>
                                                                                                                <ControlTemplate.Triggers>
                                                                                                                        <Trigger Property="IsMouseOver"
                                                                                                                                 Value="True">
                                                                                                                                <Setter TargetName="Bd"
                                                                                                                                        Property="Background"
                                                                                                                                        Value="#A0000000"/>
                                                                                                                                <Setter TargetName="Bd"
                                                                                                                                        Property="BorderBrush"
                                                                                                                                        Value="#FFFFFF"/>
                                                                                                                        </Trigger>
                                                                                                                </ControlTemplate.Triggers>
                                                                                                        </ControlTemplate>
                                                                                                </Button.Template>
                                                                                        </Button>
                                                                                </Grid>
                                                                        </Border>
                                                                </StackPanel>
                                                        </Grid>

                                                        <!-- 时间轴 -->
                                                        <TextBlock Text="时间轴"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Border Background="#FAFBFC"
                                                                CornerRadius="8"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10"
                                                                Margin="0,0,0,16">
                                                                <hc:TextBox Text="{Binding FormTimeline, UpdateSourceTrigger=PropertyChanged}"
                                                                            AcceptsReturn="True"
                                                                            TextWrapping="Wrap"
                                                                            Height="96"
                                                                            VerticalScrollBarVisibility="Auto"
                                                                            VerticalContentAlignment="Top"
                                                                            BorderThickness="0"
                                                                            Background="Transparent"
                                                                            Padding="0"
                                                                            hc:InfoElement.Placeholder="一行一个时间轴（含台词/动作/音效）&#10;例：&#10;0-2s 星野抬头望向星空&#10;2-4s 星野轻声说：'我们出发吧'&#10;4-6s 镜头缓缓拉远，星舰启动"/>
                                                        </Border>

                                                        <!-- 画面描述 -->
                                                        <TextBlock Text="画面描述"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Border Background="#FAFBFC"
                                                                CornerRadius="8"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10"
                                                                Margin="0,0,0,16">
                                                                <hc:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                                                            AcceptsReturn="True"
                                                                            TextWrapping="Wrap"
                                                                            Height="88"
                                                                            VerticalScrollBarVisibility="Auto"
                                                                            VerticalContentAlignment="Top"
                                                                            BorderThickness="0"
                                                                            Background="Transparent"
                                                                            Padding="0"
                                                                            hc:InfoElement.Placeholder="例：星野在星港码头眺望星空，眼神坚定，晨光洒落"/>
                                                        </Border>

                                                        <!-- 本镜资产 -->
                                                        <TextBlock Text="本镜资产（BGM/音效可设播放时间段）"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Border Background="#FAFBFC"
                                                                CornerRadius="8"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10">
                                                                <StackPanel>
                                                                        <Button Content="＋ 绑定资产"
                                                                                Style="{StaticResource SecondaryButton}"
                                                                                Command="{Binding BindAssetCommand}"
                                                                                HorizontalAlignment="Left"
                                                                                FontSize="13"
                                                                                Margin="0,0,0,10"/>
                                                                        <ItemsControl ItemsSource="{Binding ShotAssets}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                                <StackPanel/>
                                                                                        </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <Border Background="White"
                                                                                                        CornerRadius="8"
                                                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                                                        BorderThickness="1"
                                                                                                        Padding="10,8"
                                                                                                        Margin="0,0,0,8">
                                                                                                        <Grid>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                </Grid.ColumnDefinitions>
                                                                                                                <!-- 类型标签 -->
                                                                                                                <Border Grid.Column="0"
                                                                                                                        Background="{StaticResource PrimaryLightBrush}"
                                                                                                                        CornerRadius="4"
                                                                                                                        Padding="6,1"
                                                                                                                        VerticalAlignment="Center"
                                                                                                                        Margin="0,0,10,0">
                                                                                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                                                                                   FontSize="10"
                                                                                                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                                                                                                </Border>
                                                                                                                <!-- 名称 -->
                                                                                                                <TextBlock Grid.Column="1"
                                                                                                                           Text="{Binding Name}"
                                                                                                                           FontWeight="SemiBold"
                                                                                                                           FontSize="12"
                                                                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                                           VerticalAlignment="Center"
                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                                <!-- 参考图序号（图片类） -->
                                                                                                                <TextBlock Grid.Column="2"
                                                                                                                           Text="{Binding MediaIndexText}"
                                                                                                                           FontSize="11"
                                                                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                                                                           VerticalAlignment="Center"
                                                                                                                           Margin="0,0,10,0"
                                                                                                                           Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                                                                                                <!-- 播放时间段（BGM/音效） -->
                                                                                                                <StackPanel Grid.Column="2"
                                                                                                                            Orientation="Horizontal"
                                                                                                                            VerticalAlignment="Center"
                                                                                                                            Margin="0,0,10,0"
                                                                                                                            Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}">
                                                                                                                        <TextBlock Text="开始"
                                                                                                                                   FontSize="11"
                                                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                                                   VerticalAlignment="Center"
                                                                                                                                   Margin="0,0,4,0"/>
                                                                                                                        <hc:TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                                    Width="52"
                                                                                                                                    FontSize="11"
                                                                                                                                    VerticalContentAlignment="Center"
                                                                                                                                    hc:InfoElement.Placeholder="0"/>
                                                                                                                        <TextBlock Text="~"
                                                                                                                                   FontSize="11"
                                                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                                                   VerticalAlignment="Center"
                                                                                                                                   Margin="6,0"/>
                                                                                                                        <hc:TextBox Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                                    Width="52"
                                                                                                                                    FontSize="11"
                                                                                                                                    VerticalContentAlignment="Center"
                                                                                                                                    hc:InfoElement.Placeholder="5"/>
                                                                                                                        <TextBlock Text="s"
                                                                                                                                   FontSize="11"
                                                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                                                   VerticalAlignment="Center"
                                                                                                                                   Margin="6,0,0,0"/>
                                                                                                                </StackPanel>
                                                                                                                <!-- 解绑按钮 -->
                                                                                                                <Button Grid.Column="3"
                                                                                                                        Content="×"
                                                                                                                        Width="20"
                                                                                                                        Height="20"
                                                                                                                        FontSize="13"
                                                                                                                        FontWeight="Bold"
                                                                                                                        Foreground="White"
                                                                                                                        Background="#E74C3C"
                                                                                                                        BorderThickness="0"
                                                                                                                        Cursor="Hand"
                                                                                                                        VerticalAlignment="Center"
                                                                                                                        ToolTip="取消绑定"
                                                                                                                        Command="{Binding DataContext.UnbindAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                        CommandParameter="{Binding}">
                                                                                                                        <Button.Template>
                                                                                                                                <ControlTemplate TargetType="Button">
                                                                                                                                        <Border x:Name="Bd"
                                                                                                                                                Background="{TemplateBinding Background}"
                                                                                                                                                CornerRadius="10">
                                                                                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                                                                                  VerticalAlignment="Center"/>
                                                                                                                                        </Border>
                                                                                                                                        <ControlTemplate.Triggers>
                                                                                                                                                <Trigger Property="IsMouseOver"
                                                                                                                                                         Value="True">
                                                                                                                                                        <Setter TargetName="Bd"
                                                                                                                                                                Property="Opacity"
                                                                                                                                                                Value="0.8"/>
                                                                                                                                                </Trigger>
                                                                                                                                        </ControlTemplate.Triggers>
                                                                                                                                </ControlTemplate>
                                                                                                                        </Button.Template>
                                                                                                                </Button>
                                                                                                        </Grid>
                                                                                                </Border>
                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <TextBlock Text="暂无绑定资产，点击「＋ 绑定资产」添加（BGM/音效可绑定多个，并设置各自播放时间段）"
                                                                                   Style="{StaticResource EmptyHint}"
                                                                                   FontSize="12"
                                                                                   HorizontalAlignment="Center"
                                                                                   Visibility="{Binding ShotAssets.Count, Converter={StaticResource CountToVis}}"/>
                                                                </StackPanel>
                                                        </Border>

                                                        <!-- 视频提示词 -->
                                                        <TextBlock Text="视频提示词"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Border Background="#FAFBFC"
                                                                CornerRadius="8"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10"
                                                                Margin="0,0,0,16">
                                                                <StackPanel>
                                                                        <TextBlock Text="正向提示词（中英文均可）"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:TextBox Text="{Binding FormPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                                                    AcceptsReturn="True"
                                                                                    TextWrapping="Wrap"
                                                                                    Height="88"
                                                                                    VerticalScrollBarVisibility="Auto"
                                                                                    VerticalContentAlignment="Top"
                                                                                    BorderThickness="0"
                                                                                    Background="Transparent"
                                                                                    Padding="0"
                                                                                    hc:InfoElement.Placeholder="描述画面内容，可写中文或英文"/>
                                                                        <TextBlock Text="反向提示词（中英文均可）"
                                                                                   Style="{StaticResource FieldLabel}"
                                                                                   Margin="0,10,0,4"/>
                                                                        <hc:TextBox Text="{Binding FormNegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                                                    AcceptsReturn="True"
                                                                                    TextWrapping="Wrap"
                                                                                    Height="64"
                                                                                    VerticalScrollBarVisibility="Auto"
                                                                                    VerticalContentAlignment="Top"
                                                                                    BorderThickness="0"
                                                                                    Background="Transparent"
                                                                                    Padding="0"
                                                                                    hc:InfoElement.Placeholder="不希望出现的内容，可写中文或英文"/>
                                                                </StackPanel>
                                                        </Border>
                                                </StackPanel>
                                        </ScrollViewer>
                                </Grid>
                        </Border>
                </Grid>
        </Grid>
</UserControl>
