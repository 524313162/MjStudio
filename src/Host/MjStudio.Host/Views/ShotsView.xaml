<UserControl x:Class="MjStudio.Host.Views.ShotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
        <Grid>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左侧：集列表 ===== -->
                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        Padding="10"
                        Margin="0,0,16,0">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 顶部：分集标题 + 集数 -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource PageBgBrush}"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,10">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="🎬"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"/>
                                                        <TextBlock Text="分集"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                                CornerRadius="8"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Episodes.Count, StringFormat='{}{0}'}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                        </Border>
                                                </StackPanel>
                                        </Grid>
                                </Border>

                                <!-- 集列表 -->
                                <Grid Grid.Row="1">
                                        <ListBox ItemsSource="{Binding Episodes}"
                                                 SelectedItem="{Binding SelectedEpisode}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding"
                                                                        Value="0"/>
                                                                <Setter Property="Margin"
                                                                        Value="0,0,0,8"/>
                                                                <Setter Property="HorizontalContentAlignment"
                                                                        Value="Stretch"/>
                                                                <Setter Property="Background"
                                                                        Value="Transparent"/>
                                                                <Setter Property="BorderThickness"
                                                                        Value="0"/>
                                                                <Setter Property="Template">
                                                                        <Setter.Value>
                                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                                        <Border x:Name="Bd"
                                                                                                Background="{TemplateBinding Background}"
                                                                                                CornerRadius="8"
                                                                                                Padding="12,10">
                                                                                                <ContentPresenter/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsMouseOver"
                                                                                                         Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="Background"
                                                                                                                Value="{StaticResource PageBgBrush}"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsSelected"
                                                                                                         Value="True">
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="Background"
                                                                                                                Value="{StaticResource PrimaryLightBrush}"/>
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="BorderBrush"
                                                                                                                Value="{StaticResource PrimaryBrush}"/>
                                                                                                        <Setter TargetName="Bd"
                                                                                                                Property="BorderThickness"
                                                                                                                Value="1"/>
                                                                                                </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- 集数徽章 -->
                                                                        <Border Grid.Column="0"
                                                                                Width="40"
                                                                                Height="40"
                                                                                CornerRadius="20"
                                                                                Background="{StaticResource PrimaryLightBrush}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,12,0">
                                                                                <TextBlock Text="{Binding EpisodeNo, StringFormat='{}{0}'}"
                                                                                           FontSize="15"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"/>
                                                                        </Border>

                                                                        <!-- 名称 + 镜头数 -->
                                                                        <StackPanel Grid.Column="1"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="SemiBold"
                                                                                           FontSize="13"
                                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding Shots.Count, StringFormat='{}{0} 个镜头'}"
                                                                                           FontSize="11"
                                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                                           Margin="0,3,0,0"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="暂无分集"
                                                   Style="{StaticResource EmptyHint}"
                                                   FontSize="12"
                                                   Visibility="{Binding Episodes.Count, Converter={StaticResource CountToVis}}"/>
                                </Grid>
                        </Grid>
                </Border>

                <!-- ===== 右侧：镜头列表 + 编辑表单 ===== -->
                <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 镜头列表 -->
                        <Border Grid.Column="0"
                                Style="{StaticResource Card}"
                                Padding="10"
                                Margin="0,0,16,0">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- 顶部：镜头标题 + 新建 -->
                                        <Border Grid.Row="0"
                                                Background="{StaticResource PageBgBrush}"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,10">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="🎞️"
                                                                           FontSize="14"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <TextBlock Text="镜头"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Background="{StaticResource PrimaryLightBrush}"
                                                                        CornerRadius="8"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Shots.Count, StringFormat='{}{0}'}"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                                </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding CreateShotCommand}"
                                                                ToolTip="新建镜头"
                                                                Width="30"
                                                                Height="30"
                                                                Cursor="Hand">
                                                                <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="Bd"
                                                                                        Background="{StaticResource PrimaryBrush}"
                                                                                        CornerRadius="15">
                                                                                        <TextBlock Text="＋"
                                                                                                   FontSize="16"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="White"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver"
                                                                                                 Value="True">
                                                                                                <Setter TargetName="Bd"
                                                                                                        Property="Opacity"
                                                                                                        Value="0.85"/>
                                                                                        </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                </Button.Template>
                                                        </Button>
                                                </Grid>
                                        </Border>

                                        <!-- 镜头列表 -->
                                        <Grid Grid.Row="1">
                                                <ListBox ItemsSource="{Binding Shots}"
                                                         SelectedItem="{Binding SelectedShot}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                        <Setter Property="Padding"
                                                                                Value="0"/>
                                                                        <Setter Property="Margin"
                                                                                Value="0,0,0,8"/>
                                                                        <Setter Property="HorizontalContentAlignment"
                                                                                Value="Stretch"/>
                                                                        <Setter Property="Background"
                                                                                Value="Transparent"/>
                                                                        <Setter Property="BorderThickness"
                                                                                Value="0"/>
                                                                        <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                                                <Border x:Name="Bd"
                                                                                                        Background="{TemplateBinding Background}"
                                                                                                        CornerRadius="8"
                                                                                                        Padding="12,10">
                                                                                                        <ContentPresenter/>
                                                                                                </Border>
                                                                                                <ControlTemplate.Triggers>
                                                                                                        <Trigger Property="IsMouseOver"
                                                                                                                 Value="True">
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="{StaticResource PageBgBrush}"/>
                                                                                                        </Trigger>
                                                                                                        <Trigger Property="IsSelected"
                                                                                                                 Value="True">
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="Background"
                                                                                                                        Value="{StaticResource PrimaryLightBrush}"/>
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="BorderBrush"
                                                                                                                        Value="{StaticResource PrimaryBrush}"/>
                                                                                                                <Setter TargetName="Bd"
                                                                                                                        Property="BorderThickness"
                                                                                                                        Value="1"/>
                                                                                                        </Trigger>
                                                                                                </ControlTemplate.Triggers>
                                                                                        </ControlTemplate>
                                                                                </Setter.Value>
                                                                        </Setter>
                                                                </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- 镜头号徽章 -->
                                                                                <Border Grid.Column="0"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        CornerRadius="18"
                                                                                        Background="{StaticResource PrimaryLightBrush}"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="0,0,10,0">
                                                                                        <TextBlock Text="{Binding ShotNo, StringFormat='{}{0}'}"
                                                                                                   FontSize="13"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </Border>

                                                                                <!-- 标题 + 摘要 -->
                                                                                <StackPanel Grid.Column="1"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Title}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   FontSize="13"
                                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Text="{Binding VideoContent}"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   MaxHeight="32"
                                                                                                   Margin="0,3,0,0"/>
                                                                                </StackPanel>
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="暂无镜头，点击上方「＋」新建"
                                                           Style="{StaticResource EmptyHint}"
                                                           FontSize="12"
                                                           Visibility="{Binding Shots.Count, Converter={StaticResource CountToVis}}"/>
                                        </Grid>
                                </Grid>
                        </Border>

                        <!-- 编辑表单 -->
                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Padding="20">
                                <Grid>
                                        <!-- 空状态 -->
                                        <StackPanel Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <TextBlock Text="🎬"
                                                           FontSize="48"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="选择左侧镜头查看详情，或点击「＋」新建"
                                                           Style="{StaticResource EmptyHint}"/>
                                        </StackPanel>

                                        <!-- 编辑表单 -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                                                <StackPanel MaxWidth="1000"
                                                            HorizontalAlignment="Stretch">
                                                        <!-- 标题行 -->
                                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                                CornerRadius="8"
                                                                Padding="16,12"
                                                                Margin="0,0,0,16">
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0"
                                                                                Background="{StaticResource PrimaryBrush}"
                                                                                CornerRadius="6"
                                                                                Padding="10,4"
                                                                                Margin="0,0,12,0"
                                                                                VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding SelectedShot.ShotNo, StringFormat='镜头#{0}'}"
                                                                                           FontSize="13"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="White"/>
                                                                        </Border>
                                                                        <hc:TextBox Grid.Column="1"
                                                                                    Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                                    FontSize="16"
                                                                                    FontWeight="Bold"
                                                                                    Padding="8,6"
                                                                                    hc:InfoElement.Placeholder="镜头标题"
                                                                                    VerticalAlignment="Center"/>
                                                                        <Button Grid.Column="2"
                                                                                Content="💾 保存"
                                                                                Style="{StaticResource PrimaryButton}"
                                                                                Command="{Binding SaveCommand}"
                                                                                Margin="12,0,0,0"
                                                                                FontSize="13"/>
                                                                        <Button Grid.Column="3"
                                                                                Content="取消"
                                                                                Style="{StaticResource SecondaryButton}"
                                                                                Command="{Binding CancelEditCommand}"
                                                                                Margin="8,0,0,0"
                                                                                FontSize="13"/>
                                                                        <Button Grid.Column="4"
                                                                                Content="🗑 删除"
                                                                                Style="{StaticResource DangerButton}"
                                                                                Command="{Binding DeleteCommand}"
                                                                                Margin="8,0,0,0"
                                                                                FontSize="13"
                                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                                                </Grid>
                                                        </Border>

                                                        <!-- 画面描述 -->
                                                        <TextBlock Text="画面描述"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Border Background="#FAFBFC"
                                                                CornerRadius="8"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10"
                                                                Margin="0,0,0,20">
                                                                <hc:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                                                            AcceptsReturn="True"
                                                                            TextWrapping="Wrap"
                                                                            Height="88"
                                                                            VerticalScrollBarVisibility="Auto"
                                                                            VerticalContentAlignment="Top"
                                                                            BorderThickness="0"
                                                                            Background="Transparent"
                                                                            Padding="0"
                                                                            hc:InfoElement.Placeholder="例：星野在星港码头眺望星空，眼神坚定，晨光洒落"/>
                                                        </Border>

                                                        <!-- 运镜与景别 -->
                                                        <TextBlock Text="运镜与景别"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Grid Margin="0,0,0,20">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="运镜"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding CameraOptions}"
                                                                                     SelectedItem="{Binding FormCamera, UpdateSourceTrigger=PropertyChanged}"
                                                                                     hc:InfoElement.Placeholder="选择运镜方式"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="景别"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding ShotSizeOptions}"
                                                                                     SelectedItem="{Binding FormShotSize, UpdateSourceTrigger=PropertyChanged}"
                                                                                     hc:InfoElement.Placeholder="选择景别"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="4">
                                                                        <TextBlock Text="机位朝向"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding CameraFacingOptions}"
                                                                                     SelectedItem="{Binding FormCameraFacing, UpdateSourceTrigger=PropertyChanged}"
                                                                                     hc:InfoElement.Placeholder="选择机位朝向"/>
                                                                </StackPanel>
                                                        </Grid>

                                                        <!-- 时间轴 -->
                                                        <TextBlock Text="时间轴"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Border Background="#FAFBFC"
                                                                CornerRadius="8"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10"
                                                                Margin="0,0,0,20">
                                                                <hc:TextBox Text="{Binding FormTimeline, UpdateSourceTrigger=PropertyChanged}"
                                                                            AcceptsReturn="True"
                                                                            TextWrapping="Wrap"
                                                                            Height="96"
                                                                            VerticalScrollBarVisibility="Auto"
                                                                            VerticalContentAlignment="Top"
                                                                            BorderThickness="0"
                                                                            Background="Transparent"
                                                                            Padding="0"
                                                                            hc:InfoElement.Placeholder="一行一个时间轴（含台词/动作/音效）&#10;例：&#10;0-2s 星野抬头望向星空&#10;2-4s 星野轻声说：'我们出发吧'&#10;4-6s 镜头缓缓拉远，星舰启动"/>
                                                        </Border>

                                                        <!-- 音频与转场 -->
                                                        <TextBlock Text="音频与转场"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Grid Margin="0,0,0,20">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="BGM（从资产选择）"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding BgmAssets}"
                                                                                     SelectedItem="{Binding FormBgm, UpdateSourceTrigger=PropertyChanged}"
                                                                                     DisplayMemberPath="Name"
                                                                                     hc:InfoElement.Placeholder="选择 BGM 资产"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="BGM 播放时间段"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:TextBox Text="{Binding FormBgmRange, UpdateSourceTrigger=PropertyChanged}"
                                                                                    hc:InfoElement.Placeholder="如 0-5s"/>
                                                                </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,20">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="环境音效（从资产选择）"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding SfxAssets}"
                                                                                     SelectedItem="{Binding FormAmbientSfx, UpdateSourceTrigger=PropertyChanged}"
                                                                                     DisplayMemberPath="Name"
                                                                                     hc:InfoElement.Placeholder="选择音效资产"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="音效播放时间段"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:TextBox Text="{Binding FormSfxRange, UpdateSourceTrigger=PropertyChanged}"
                                                                                    hc:InfoElement.Placeholder="如 0-5s"/>
                                                                </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,20">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="转场"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding TransitionOptions}"
                                                                                     SelectedItem="{Binding FormTransition, UpdateSourceTrigger=PropertyChanged}"
                                                                                     hc:InfoElement.Placeholder="选择转场方式"/>
                                                                </StackPanel>
                                                        </Grid>

                                                        <!-- 视频提示词 -->
                                                        <TextBlock Text="视频提示词"
                                                                   Style="{StaticResource SectionTitle}"/>
                                                        <Border Background="#FAFBFC"
                                                                CornerRadius="8"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10"
                                                                Margin="0,0,0,16">
                                                                <StackPanel>
                                                                        <TextBlock Text="正向提示词（中英文均可）"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:TextBox Text="{Binding FormPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                                                    AcceptsReturn="True"
                                                                                    TextWrapping="Wrap"
                                                                                    Height="88"
                                                                                    VerticalScrollBarVisibility="Auto"
                                                                                    VerticalContentAlignment="Top"
                                                                                    BorderThickness="0"
                                                                                    Background="Transparent"
                                                                                    Padding="0"
                                                                                    hc:InfoElement.Placeholder="描述画面内容，可写中文或英文"/>
                                                                        <TextBlock Text="反向提示词（中英文均可）"
                                                                                   Style="{StaticResource FieldLabel}"
                                                                                   Margin="0,10,0,4"/>
                                                                        <hc:TextBox Text="{Binding FormNegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                                                    AcceptsReturn="True"
                                                                                    TextWrapping="Wrap"
                                                                                    Height="64"
                                                                                    VerticalScrollBarVisibility="Auto"
                                                                                    VerticalContentAlignment="Top"
                                                                                    BorderThickness="0"
                                                                                    Background="Transparent"
                                                                                    Padding="0"
                                                                                    hc:InfoElement.Placeholder="不希望出现的内容，可写中文或英文"/>
                                                                </StackPanel>
                                                        </Border>
                                                </StackPanel>
                                        </ScrollViewer>
                                </Grid>
                        </Border>
                </Grid>
        </Grid>
</UserControl>
