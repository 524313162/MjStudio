<UserControl x:Class="MjStudio.Host.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:MjStudio.Host.Converters">
    <UserControl.Resources>
        <conv:StageNameConverter x:Key="StageName"/>
        <conv:DecisionNameConverter x:Key="DecisionName"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <TextBlock Text="评审结论由 agent 经 API 写入，此处只读查看。"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button Content="刷新"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}"
                    FontSize="13"/>
            <TextBlock Text="{Binding Reviews.Count, StringFormat='共 {0} 条'}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 评审列表 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="8"
                    Margin="0,0,16,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Reviews}"
                             SelectedItem="{Binding Selected}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Stage, Converter={StaticResource StageName}}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Decision, Converter={StaticResource DecisionName}}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="暂无评审记录"
                               Style="{StaticResource EmptyHint}"
                               Visibility="{Binding Reviews.Count, Converter={StaticResource CountToVis}}"/>
                </Grid>
            </Border>

            <!-- 评审详情 -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}">
                <Grid>
                    <!-- 空状态 -->
                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="✅"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="选择左侧评审记录查看详情"
                                   Style="{StaticResource EmptyHint}"/>
                    </StackPanel>

                    <!-- 详情 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Selected, Converter={StaticResource NullToVisInverse}}">
                        <StackPanel MaxWidth="860"
                                    HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,16">
                                <TextBlock Text="{Binding Selected.Stage, Converter={StaticResource StageName}}"
                                           Style="{StaticResource PageTitle}"
                                           Margin="0"/>
                                <TextBlock Text="{Binding Selected.Decision, Converter={StaticResource DecisionName}}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center">
                                    <Run Text="打回次数："/><Run Text="{Binding Selected.RevisionCount, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <hc:Card Header="评审正文"
                                     Margin="0,0,0,16"
                                     Padding="14">
                                <TextBlock Text="{Binding Selected.Content}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </hc:Card>

                            <hc:Card Header="问题清单"
                                     Margin="0,0,0,16"
                                     Padding="14">
                                <TextBlock Text="{Binding Selected.Issues}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </hc:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
