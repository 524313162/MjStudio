<UserControl x:Class="MjStudio.Host.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
        <Grid>
                <!-- ===== 主内容区：卡片网格 ===== -->
                <DockPanel>
                        <!-- 顶部：搜索 + 新建项目 -->
                        <Border DockPanel.Dock="Top"
                                Style="{StaticResource Card}"
                                Padding="16"
                                Margin="0,0,0,16">
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="240"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="🔍"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <hc:TextBox Grid.Column="1"
                                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                    hc:InfoElement.Placeholder="搜索项目（名称 / 故事名）"
                                                    FontSize="13"/>
                                        <Button Grid.Column="2"
                                                Content="搜索"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding SearchCommand}"
                                                FontSize="13"
                                                Padding="14,7"
                                                Margin="8,0,0,0"/>
                                        <Button Grid.Column="3"
                                                Content="🔄 刷新"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding RefreshCommand}"
                                                ToolTip="重新加载项目列表（外部/HTTP 创建的项目需刷新后显示）"
                                                FontSize="13"
                                                Padding="14,7"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Right"/>
                                        <Button Grid.Column="4"
                                                Content="＋ 新建项目"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding CreateCommand}"
                                                FontSize="13"
                                                Padding="16,7"/>
                                </Grid>
                        </Border>

                        <!-- 卡片网格 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                        <!-- 空状态 -->
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding FilteredCards.Count, Converter={StaticResource CountToVis}}">
                                                <TextBlock Text="📁"
                                                           FontSize="48"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="暂无项目，点击右上角「新建项目」创建"
                                                           Style="{StaticResource EmptyHint}"/>
                                        </StackPanel>

                                        <!-- 卡片列表（顶部对齐：不随可视区高度拉伸） -->
                                        <ItemsControl ItemsSource="{Binding FilteredCards}"
                                                      VerticalAlignment="Top">
                                                <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                                <UniformGrid Columns="4"/>
                                                        </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                <Border Background="White"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Margin="0,0,12,12"
                                                                        Height="224"
                                                                        Cursor="Hand"
                                                                        MouseLeftButtonDown="OnCardClick">
                                                                        <Border.Effect>
                                                                                <DropShadowEffect BlurRadius="12"
                                                                                                  ShadowDepth="2"
                                                                                                  Opacity="0.08"
                                                                                                  Color="#000000"/>
                                                                        </Border.Effect>
                                                                        <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                                <Trigger Property="IsMouseOver"
                                                                                                         Value="True">
                                                                                                        <Setter Property="BorderBrush"
                                                                                                                Value="{StaticResource PrimaryBrush}"/>
                                                                                                        <Setter Property="Background"
                                                                                                                Value="{StaticResource PrimaryLightBrush}"/>
                                                                                                </Trigger>
                                                                                        </Style.Triggers>
                                                                                </Style>
                                                                        </Border.Style>

                                                                        <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="4"/>
                                                                                        <RowDefinition Height="*"/>
                                                                                </Grid.RowDefinitions>
                                                                                <!-- 顶部强调条 -->
                                                                                <Border Grid.Row="0"
                                                                                        CornerRadius="12,12,0,0"
                                                                                        Background="{StaticResource PrimaryBrush}"/>

                                                                                <!-- 内容区：行栅格，底部按钮始终锚定，标签区吃掉剩余空间 -->
                                                                                <Border Grid.Row="1" Padding="14,12,14,14">
                                                                                        <Grid>
                                                                                                <Grid.RowDefinitions>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                        <RowDefinition Height="*"/>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                        <RowDefinition Height="Auto"/>
                                                                                                </Grid.RowDefinitions>
                                                                                                <!-- 名称 + 当前标记（名称占满剩余宽度后省略，徽标不被挤出卡片） -->
                                                                                                <!-- 右侧留 26px 给删除角标，避免与「当前」徽标重叠 -->
                                                                                                <Grid Grid.Row="0"
                                                                                                      Margin="0,0,26,4">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <TextBlock Grid.Column="0"
                                                                                                                   Text="{Binding Name}"
                                                                                                                   FontSize="15"
                                                                                                                   FontWeight="Bold"
                                                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                                        <Border Grid.Column="1"
                                                                                                                Background="{StaticResource PrimaryBrush}"
                                                                                                                CornerRadius="4"
                                                                                                                Padding="6,2"
                                                                                                                Margin="8,0,0,0"
                                                                                                                VerticalAlignment="Center">
                                                                                                                <Border.Visibility>
                                                                                                                        <MultiBinding Converter="{StaticResource MultiEqVis}">
                                                                                                                                <Binding Path="Name"/>
                                                                                                                                <Binding Path="DataContext.CurrentProjectName"
                                                                                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                                                        </MultiBinding>
                                                                                                                </Border.Visibility>
                                                                                                                <TextBlock Text="当前"
                                                                                                                           FontSize="10"
                                                                                                                           Foreground="White"/>
                                                                                                        </Border>
                                                                                                </Grid>

                                                                                                <!-- 故事名称 -->
                                                                                                <TextBlock Grid.Row="1"
                                                                                                           Text="{Binding StoryName, TargetNullValue='未命名', FallbackValue='未命名'}"
                                                                                                           FontSize="12"
                                                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                           Margin="0,0,0,8"/>

                                                                                                <!-- 规格信息：题材 / 平台 各固定单行，超出裁剪，避免换行顶高卡片 -->
                                                                                                <Grid Grid.Row="2"
                                                                                                      Margin="0,0,0,8"
                                                                                                      VerticalAlignment="Top"
                                                                                                      ClipToBounds="True">
                                                                                                        <Grid.RowDefinitions>
                                                                                                                <RowDefinition Height="24"/>
                                                                                                                <RowDefinition Height="24"/>
                                                                                                        </Grid.RowDefinitions>
                                                                                                        <!-- 题材 -->
                                                                                                        <StackPanel Grid.Row="0"
                                                                                                                    Orientation="Horizontal"
                                                                                                                    ClipToBounds="True">
                                                                                                                <TextBlock Text="题材"
                                                                                                                           Width="40"
                                                                                                                           VerticalAlignment="Center"
                                                                                                                           FontSize="12"
                                                                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                                                                                <ItemsControl ItemsSource="{Binding Genre, Converter={StaticResource TagSplit}, ConverterParameter='未分类'}"
                                                                                                                              VerticalAlignment="Center">
                                                                                                                        <ItemsControl.ItemsPanel>
                                                                                                                                <ItemsPanelTemplate>
                                                                                                                                        <WrapPanel/>
                                                                                                                                </ItemsPanelTemplate>
                                                                                                                        </ItemsControl.ItemsPanel>
                                                                                                                        <ItemsControl.ItemTemplate>
                                                                                                                                <DataTemplate>
                                                                                                                                        <Border Background="{StaticResource PageBgBrush}"
                                                                                                                                                CornerRadius="4"
                                                                                                                                                Padding="8,3"
                                                                                                                                                Margin="0,0,6,0">
                                                                                                                                                <TextBlock Text="{Binding}"
                                                                                                                                                           FontSize="11"
                                                                                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                                                                        </Border>
                                                                                                                                </DataTemplate>
                                                                                                                        </ItemsControl.ItemTemplate>
                                                                                                                </ItemsControl>
                                                                                                        </StackPanel>
                                                                                                        <!-- 平台 -->
                                                                                                        <StackPanel Grid.Row="1"
                                                                                                                    Orientation="Horizontal"
                                                                                                                    ClipToBounds="True">
                                                                                                                <TextBlock Text="平台"
                                                                                                                           Width="40"
                                                                                                                           VerticalAlignment="Center"
                                                                                                                           FontSize="12"
                                                                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                                                                                <ItemsControl ItemsSource="{Binding TargetPlatform, Converter={StaticResource TagSplit}, ConverterParameter='未定'}"
                                                                                                                              VerticalAlignment="Center">
                                                                                                                        <ItemsControl.ItemsPanel>
                                                                                                                                <ItemsPanelTemplate>
                                                                                                                                        <WrapPanel/>
                                                                                                                                </ItemsPanelTemplate>
                                                                                                                        </ItemsControl.ItemsPanel>
                                                                                                                        <ItemsControl.ItemTemplate>
                                                                                                                                <DataTemplate>
                                                                                                                                        <Border Background="{StaticResource PageBgBrush}"
                                                                                                                                                CornerRadius="4"
                                                                                                                                                Padding="8,3"
                                                                                                                                                Margin="0,0,6,0">
                                                                                                                                                <TextBlock Text="{Binding}"
                                                                                                                                                           FontSize="11"
                                                                                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                                                                        </Border>
                                                                                                                                </DataTemplate>
                                                                                                                        </ItemsControl.ItemTemplate>
                                                                                                                </ItemsControl>
                                                                                                        </StackPanel>
                                                                                                </Grid>

                                                                                                <!-- 分隔线 -->
                                                                                                <Border Grid.Row="3"
                                                                                                        Height="1"
                                                                                                        Background="{StaticResource BorderBrush}"
                                                                                                        Margin="0,0,0,8"/>

                                                                                                <!-- 规格行：画幅 · 集数 · 环节 -->
                                                                                                <StackPanel Grid.Row="4"
                                                                                                            Orientation="Horizontal"
                                                                                                            ClipToBounds="True"
                                                                                                            Margin="0,0,0,10">
                                                                                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                                                                                CornerRadius="4"
                                                                                                                Padding="8,3"
                                                                                                                Margin="0,0,8,0">
                                                                                                                <TextBlock Text="{Binding AspectRatio, Converter={StaticResource EnumDisplay}}"
                                                                                                                           FontSize="11"
                                                                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                                                                           FontWeight="SemiBold"/>
                                                                                                        </Border>
                                                                                                        <TextBlock Text="{Binding TotalEpisodes, StringFormat='{}{0} 集'}"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Margin="0,0,8,0"/>
                                                                                                        <Border Background="{StaticResource PageBgBrush}"
                                                                                                                CornerRadius="4"
                                                                                                                Padding="8,3">
                                                                                                                <TextBlock Text="{Binding CurrentStage, Converter={StaticResource EnumDisplay}}"
                                                                                                                           FontSize="11"
                                                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                                        </Border>
                                                                                                </StackPanel>

                                                                                                <!-- 创作入口：剧本创作（左）+ 漫剧创作（右） -->
                                                                                                <Grid Grid.Row="5">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="8"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <Button Grid.Column="0"
                                                                                                                Content="📝 剧本创作"
                                                                                                                Style="{StaticResource SecondaryButton}"
                                                                                                                FontSize="12"
                                                                                                                Padding="0,7"
                                                                                                                Command="{Binding DataContext.OpenStoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                CommandParameter="{Binding}"/>
                                                                                                        <Button Grid.Column="2"
                                                                                                                Content="🎬 漫剧创作"
                                                                                                                Style="{StaticResource PrimaryButton}"
                                                                                                                FontSize="12"
                                                                                                                Padding="0,7"
                                                                                                                Command="{Binding DataContext.OpenShotsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                CommandParameter="{Binding}"/>
                                                                                                </Grid>
                                                                                        </Grid>
                                                                                </Border>

                                                                                <!-- 右上角删除角标（叠在内容之上；Button 内部会把 MouseLeftButtonDown 标记为已处理，不会误触发卡片点击） -->
                                                                                <Button Grid.Row="1"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Top"
                                                                                        Margin="0,5,7,0"
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Cursor="Hand"
                                                                                        ToolTip="删除项目"
                                                                                        Command="{Binding DataContext.DeleteCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                        CommandParameter="{Binding}">
                                                                                        <Button.Template>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                        <Border x:Name="Bd"
                                                                                                                CornerRadius="11"
                                                                                                                Background="#FFFFFF"
                                                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                                                BorderThickness="1">
                                                                                                                <TextBlock x:Name="Tx"
                                                                                                                           Text="✕"
                                                                                                                           FontSize="10"
                                                                                                                           FontWeight="Bold"
                                                                                                                           HorizontalAlignment="Center"
                                                                                                                           VerticalAlignment="Center"
                                                                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                                                                        </Border>
                                                                                                        <ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver"
 Value="True">
 <Setter TargetName="Bd"
 Property="Background"
 Value="{StaticResource DangerBrush}"/>
 <Setter TargetName="Bd"
 Property="BorderBrush"
 Value="{StaticResource DangerBrush}"/>
 <Setter TargetName="Tx"
 Property="Foreground"
 Value="White"/>
 </Trigger>
 <Trigger Property="IsPressed"
 Value="True">
 <Setter TargetName="Bd"
 Property="Background"
 Value="{StaticResource DangerHoverBrush}"/>
 <Setter TargetName="Bd"
 Property="BorderBrush"
 Value="{StaticResource DangerHoverBrush}"/>
 </Trigger>
                                                                                                        </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                        </Button.Template>
                                                                                </Button>
                                                                        </Grid>
                                                                </Border>
                                                        </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </Grid>
                        </ScrollViewer>
                </DockPanel>

                <!-- ===== 右侧抽屉 ===== -->
                <Grid x:Name="DrawerRoot"
                      Visibility="Collapsed">
                        <!-- 遮罩层（点击关闭） -->
                        <Border x:Name="DrawerMask"
                                Background="#66000000"
                                MouseLeftButtonDown="OnDrawerMaskClick"/>

                        <!-- 抽屉面板 -->
                        <Border x:Name="DrawerPanel"
                                HorizontalAlignment="Right"
                                Width="600"
                                Background="White">
                                <Border.Effect>
                                        <DropShadowEffect BlurRadius="28"
                                                          ShadowDepth="0"
                                                          Opacity="0.22"
                                                          Color="#1A202C"/>
                                </Border.Effect>
                                <DockPanel>
                                        <!-- 抽屉头部 -->
                                        <Border DockPanel.Dock="Top"
                                                Padding="24,16"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                                <DockPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Content="✕"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding CloseDrawerCommand}"
                                                                Padding="8,4"
                                                                FontSize="14"/>
                                                        <StackPanel>
                                                                <TextBlock Text="项目详情"
                                                                           FontSize="18"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding SelectedProject.Name}"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource PrimaryBrush}"
                                                                           Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                </DockPanel>
                                        </Border>

                                        <!-- 底部操作栏 -->
                                        <Border DockPanel.Dock="Bottom"
                                                Padding="24,14"
                                                Background="White"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                        <Button Content="🗑 删除项目"
                                                                Style="{StaticResource DangerButton}"
                                                                Command="{Binding DeleteCommand}"
                                                                FontSize="13"
                                                                Margin="0,0,12,0"/>
                                                        <Button Content="💾 保存"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding SaveCommand}"
                                                                FontSize="13"/>
                                                </StackPanel>
                                        </Border>

                                        <!-- 表单内容 -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="24">
                                                        <!-- 基本信息 -->
                                                        <StackPanel Margin="0,0,0,20">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,0,0,14">
                                                                        <Border Width="3"
                                                                                Height="14"
                                                                                CornerRadius="2"
                                                                                Background="{StaticResource PrimaryBrush}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0"/>
                                                                        <TextBlock Text="基本信息"
                                                                                   FontSize="14"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>
                                                                <!-- 项目名称（只读：项目名即数据库名与资源目录名，重命名需后端支持） -->
                                                                <TextBlock Text="项目名称"
                                                                           Style="{StaticResource FieldLabel}"/>
                                                                <hc:TextBox Text="{Binding FormName, Mode=OneWay}"
                                                                            IsReadOnly="True"
                                                                            Background="{StaticResource PageBgBrush}"
                                                                            Margin="0,0,0,12"
                                                                            ToolTip="项目名即数据库名与资源目录名，暂不支持重命名"/>

                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                                <TextBlock Text="故事名称"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:TextBox Text="{Binding FormStoryName, UpdateSourceTrigger=PropertyChanged}"
                                                                                            hc:InfoElement.Placeholder="故事名称"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                                <TextBlock Text="项目简介"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                                                                            AcceptsReturn="True"
                                                                                            Height="40"
                                                                                            VerticalScrollBarVisibility="Auto"
                                                                                            VerticalContentAlignment="Top"
                                                                                            hc:InfoElement.Placeholder="一句话介绍项目"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                                <TextBlock Text="世界观（一句话）"
                                                                           Style="{StaticResource FieldLabel}"
                                                                           Margin="0,12,0,4"/>
                                                                <hc:TextBox Text="{Binding FormWorldview, UpdateSourceTrigger=PropertyChanged}"
                                                                            AcceptsReturn="True"
                                                                            Height="48"
                                                                            VerticalScrollBarVisibility="Auto"
                                                                            VerticalContentAlignment="Top"
                                                                            hc:InfoElement.Placeholder="世界观"/>
                                                                <StackPanel Margin="0,12,0,0">
                                                                        <TextBlock Text="目标平台"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <Grid>
                                                                                <ToggleButton Height="34"
                                                                                              Style="{x:Null}"
                                                                                              BorderBrush="{StaticResource BorderBrush}"
                                                                                              BorderThickness="1"
                                                                                              Background="{StaticResource CardBgBrush}"
                                                                                              HorizontalContentAlignment="Stretch"
                                                                                              Padding="10,0"
                                                                                              IsChecked="{Binding IsPlatformOpen, Mode=TwoWay}">
                                                                                        <Grid>
                                                                                                <TextBlock Text="{Binding PlatformDisplay}"
                                                                                                           VerticalAlignment="Center"
                                                                                                           Margin="0,0,22,0"
                                                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                <Path Data="M 0 0 L 6 6 L 12 0 Z"
                                                                                                      Fill="{StaticResource TextMutedBrush}"
                                                                                                      HorizontalAlignment="Right"
                                                                                                      VerticalAlignment="Center"
                                                                                                      Margin="0,0,0,0"/>
                                                                                        </Grid>
                                                                                </ToggleButton>
                                                                                <Popup IsOpen="{Binding IsPlatformOpen, Mode=TwoWay}"
                                                                                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                                       Placement="Bottom"
                                                                                       StaysOpen="False"
                                                                                       AllowsTransparency="True"
                                                                                       PopupAnimation="Slide">
                                                                                        <Border Background="{StaticResource CardBgBrush}"
                                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="6"
                                                                                                Padding="8"
                                                                                                MinWidth="220">
                                                                                                <ItemsControl ItemsSource="{Binding PlatformItems}">
                                                                                                        <ItemsControl.ItemTemplate>
                                                                                                                <DataTemplate>
                                                                                                                        <CheckBox Content="{Binding Text}"
                                                                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                                                                  Margin="0,4"
                                                                                                                                  VerticalContentAlignment="Center"/>
                                                                                                                </DataTemplate>
                                                                                                        </ItemsControl.ItemTemplate>
                                                                                                </ItemsControl>
                                                                                        </Border>
                                                                                </Popup>
                                                                        </Grid>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,12,0,0">
                                                                        <TextBlock Text="题材"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <Grid>
                                                                                <ToggleButton Height="34"
                                                                                              Style="{x:Null}"
                                                                                              BorderBrush="{StaticResource BorderBrush}"
                                                                                              BorderThickness="1"
                                                                                              Background="{StaticResource CardBgBrush}"
                                                                                              HorizontalContentAlignment="Stretch"
                                                                                              Padding="10,0"
                                                                                              IsChecked="{Binding IsGenreOpen, Mode=TwoWay}">
                                                                                        <Grid>
                                                                                                <TextBlock Text="{Binding GenreDisplay}"
                                                                                                           VerticalAlignment="Center"
                                                                                                           Margin="0,0,22,0"
                                                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                <Path Data="M 0 0 L 6 6 L 12 0 Z"
                                                                                                      Fill="{StaticResource TextMutedBrush}"
                                                                                                      HorizontalAlignment="Right"
                                                                                                      VerticalAlignment="Center"
                                                                                                      Margin="0,0,0,0"/>
                                                                                        </Grid>
                                                                                </ToggleButton>
                                                                                <Popup IsOpen="{Binding IsGenreOpen, Mode=TwoWay}"
                                                                                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                                       Placement="Bottom"
                                                                                       StaysOpen="False"
                                                                                       AllowsTransparency="True"
                                                                                       PopupAnimation="Slide">
                                                                                        <Border Background="{StaticResource CardBgBrush}"
                                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="6"
                                                                                                Padding="8"
                                                                                                MinWidth="220">
                                                                                                <ItemsControl ItemsSource="{Binding GenreItems}">
                                                                                                        <ItemsControl.ItemTemplate>
                                                                                                                <DataTemplate>
                                                                                                                        <CheckBox Content="{Binding Text}"
                                                                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                                                                  Margin="0,4"
                                                                                                                                  VerticalContentAlignment="Center"/>
                                                                                                                </DataTemplate>
                                                                                                        </ItemsControl.ItemTemplate>
                                                                                                </ItemsControl>
                                                                                        </Border>
                                                                                </Popup>
                                                                        </Grid>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,12,0,0">
                                                                        <TextBlock Text="目标受众"
                                                                                   Style="{StaticResource FieldLabel}"/>
                                                                        <hc:ComboBox ItemsSource="{Binding AudienceOptions}"
                                                                                     Text="{Binding FormAudience, UpdateSourceTrigger=PropertyChanged}"
                                                                                     IsEditable="True"
                                                                                     VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Grid Margin="0,12,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                                <TextBlock Text="美术风格"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:ComboBox ItemsSource="{Binding ArtStyleOptions}"
                                                                                             Text="{Binding FormArtStyle, UpdateSourceTrigger=PropertyChanged}"
                                                                                             IsEditable="True"
                                                                                             VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                                <TextBlock Text="配音语言"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:ComboBox ItemsSource="{Binding VoiceLanguageOptions}"
                                                                                             Text="{Binding FormVoiceLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                                                             IsEditable="True"
                                                                                             VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                </Grid>

                                                                <Grid Margin="0,12,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                                <TextBlock Text="原创/改编"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:ComboBox ItemsSource="{Binding OriginalOrAdaptedOptions}"
                                                                                             Text="{Binding FormOriginalOrAdapted, UpdateSourceTrigger=PropertyChanged}"
                                                                                             IsEditable="True"
                                                                                             VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                                <TextBlock Text="BGM 风格"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:TextBox Text="{Binding FormBgmStyle, UpdateSourceTrigger=PropertyChanged}"
                                                                                            hc:InfoElement.Placeholder="如 轻快/悬疑"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4">
                                                                                <TextBlock Text="片头片尾"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <CheckBox Content="含片头片尾"
                                                                                          IsChecked="{Binding FormHasOpeningEnding}"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,8,0,0"/>
                                                                        </StackPanel>
                                                                </Grid>

                                                                <TextBlock Text="交付物说明"
                                                                           Style="{StaticResource FieldLabel}"
                                                                           Margin="0,12,0,4"/>
                                                                <hc:TextBox Text="{Binding FormDeliverables, UpdateSourceTrigger=PropertyChanged}"
                                                                            AcceptsReturn="True"
                                                                            Height="56"
                                                                            VerticalScrollBarVisibility="Auto"
                                                                            VerticalContentAlignment="Top"
                                                                            hc:InfoElement.Placeholder="成片交付要求（分辨率 / 格式 / 时长 / 平台规范等）"/>
                                                        </StackPanel>

                                                        <!-- 规格设置 -->
                                                        <StackPanel Margin="0,0,0,20">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,0,0,14">
                                                                        <Border Width="3"
                                                                                Height="14"
                                                                                CornerRadius="2"
                                                                                Background="{StaticResource PrimaryBrush}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0"/>
                                                                        <TextBlock Text="规格设置"
                                                                                   FontSize="14"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                                <TextBlock Text="总集数"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:TextBox Text="{Binding FormTotalEpisodes, UpdateSourceTrigger=PropertyChanged}"
                                                                                            hc:InfoElement.Placeholder="如 20"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                                <TextBlock Text="每集时长（秒）"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <hc:TextBox Text="{Binding FormEpisodeDuration, UpdateSourceTrigger=PropertyChanged}"
                                                                                            hc:InfoElement.Placeholder="如 120"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4">
                                                                                <TextBlock Text="画幅"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <ComboBox ItemsSource="{Binding AspectRatios}"
                                                                                          SelectedItem="{Binding FormAspectRatio}"
                                                                                          FontSize="13">
                                                                                        <ComboBox.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                                                                </DataTemplate>
                                                                                        </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </StackPanel>

                                                        <!-- 进度与状态 -->
                                                        <StackPanel>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,0,0,14">
                                                                        <Border Width="3"
                                                                                Height="14"
                                                                                CornerRadius="2"
                                                                                Background="{StaticResource PrimaryBrush}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0"/>
                                                                        <TextBlock Text="进度与状态"
                                                                                   FontSize="14"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                                <TextBlock Text="当前环节"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <ComboBox ItemsSource="{Binding StageOptions}"
                                                                                          SelectedItem="{Binding FormCurrentStage}"
                                                                                          FontSize="13">
                                                                                        <ComboBox.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                                                                </DataTemplate>
                                                                                        </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                                <TextBlock Text="项目状态"
                                                                                           Style="{StaticResource FieldLabel}"/>
                                                                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                                                                          SelectedItem="{Binding FormStatus}"
                                                                                          FontSize="13">
                                                                                        <ComboBox.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                                                                </DataTemplate>
                                                                                        </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </StackPanel>
                                                </StackPanel>
                                        </ScrollViewer>
                                </DockPanel>
                        </Border>
                </Grid>

                <!-- ===== 新建项目弹窗 ===== -->
                <Grid x:Name="CreateDialogRoot"
                      Visibility="Collapsed">
                        <Border x:Name="CreateDialogMask"
                                Background="#66000000"
                                MouseLeftButtonDown="OnDialogMaskClick"/>
                        <Border x:Name="CreateDialogPanel"
                                Width="400"
                                Background="White"
                                CornerRadius="14"
                                Padding="28,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border.Effect>
                                        <DropShadowEffect BlurRadius="28"
                                                          ShadowDepth="0"
                                                          Opacity="0.25"
                                                          Color="#1A202C"/>
                                </Border.Effect>
                                <StackPanel>
                                        <TextBlock Text="新建项目"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="输入项目名，将自动创建项目数据库与资源目录"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,6,0,16"
                                                   TextWrapping="Wrap"/>
                                        <hc:TextBox x:Name="NewNameBox"
                                                    Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                                    hc:InfoElement.Placeholder="如：我的漫剧"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,20,0,0">
                                                <Button Content="取消"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding CancelCreateCommand}"
                                                        Margin="0,0,10,0"/>
                                                <Button Content="创建"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding ConfirmCreateCommand}"/>
                                        </StackPanel>
                                </StackPanel>
                        </Border>
                </Grid>
        </Grid>
</UserControl>
